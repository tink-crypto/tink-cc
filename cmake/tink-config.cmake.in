@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(absl)
find_package(Protobuf CONFIG QUIET)
if(NOT Protobuf_FOUND)
  find_dependency(Protobuf)
endif()
if(@_tink_needs_threads@)
  find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/tink-targets.cmake")
set(${CMAKE_FIND_PACKAGE_NAME}_tink_FOUND TRUE)

if("testonly" IN_LIST ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/tink-testonly-targets.cmake")
    if(NOT TARGET GTest::gmock)
      if(${CMAKE_FIND_PACKAGE_NAME}_FIND_REQUIRED_testonly)
        find_dependency(GTest CONFIG)
      else()
        find_package(GTest CONFIG QUIET)
      endif()
    endif()
    if(TARGET GTest::gmock)
      include("${CMAKE_CURRENT_LIST_DIR}/tink-testonly-targets.cmake")
      set(${CMAKE_FIND_PACKAGE_NAME}_testonly_FOUND TRUE)
    else()
      set(${CMAKE_FIND_PACKAGE_NAME}_testonly_FOUND FALSE)
    endif()
  else()
    set(${CMAKE_FIND_PACKAGE_NAME}_testonly_FOUND FALSE)
    if(${CMAKE_FIND_PACKAGE_NAME}_FIND_REQUIRED_testonly)
      set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
        "${CMAKE_FIND_PACKAGE_NAME} component 'testonly' was requested, but tink-testonly-targets.cmake was not found (build Tink with TINK_BUILD_TESTONLY=ON).")
    endif()
  endif()
endif()

check_required_components(${CMAKE_FIND_PACKAGE_NAME})
