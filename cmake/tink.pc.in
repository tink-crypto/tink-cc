prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@pc_libdir@
includedir=@pc_includedir@

Name: @arg_NAME@
Description: @arg_DESCRIPTION@
URL: https://developers.google.com/tink
Version: @PROJECT_VERSION@
@pc_requires_line@Libs: "-L${libdir}" -l@output_name@@pc_extra_libs_str@
Cflags: "-I${includedir}/tink-@PROJECT_VERSION_MAJOR@"
